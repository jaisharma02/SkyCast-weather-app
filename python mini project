from tkinter import *
from tkinter import ttk

import requests

 
def data_get():
    city  = city_name.get()
    data = requests.get("https://api.openweathermap.org/data/2.5/weather?q="+ city +"&appid=195d64bafa597167f7696301411e5114").json()

    name_label1.config(text=data[ "weather"][0]["main"])
    name_label3.config(text=data[ "weather"][0]["description"])
    name_label5.config(text=str(int(data["main"]["temp"]-273.15)))
    name_label7.config(text=data["main"]["pressure"])



